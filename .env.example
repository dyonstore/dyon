# DYON — copy to .env (git-ignored, denied by every web server rule). Real environment variables win over this file.
# Any config key can be set as DYON_<UPPER_KEY>.
DYON_ENV=prod
DYON_BASE_URL=https://dyon.store
# php -r 'echo base64_encode(random_bytes(32));'
DYON_SECRET_KEY=
# Where the admin area lives: https://dyon.store/<DYON_ADMIN_PATH>/ (letters, digits, - and _). Pick something non-obvious.
DYON_ADMIN_PATH=admin
DYON_COOKIE_SECURE=1
DYON_MAIL_TRANSPORT=smtp
DYON_LOGIN_CODE=1
