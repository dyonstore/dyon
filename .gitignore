# Node
node_modules/
npm-debug.log*

# PHP / Composer (per TASKS.md: /vendor is self-hosted fonts/icons, so PHP deps go to vendor-php)
vendor-php/
.tools/
composer.lock

# Server runtime data — never committed (SQLite DBs, avatars, mail spool, backups).
# NOTE: data/countries.json is canonical *source* data and IS committed (see !rule).
/data/*.sqlite
/data/*.sqlite-*
/data/system.sqlite*
/data/users/
/data/avatars/
/data/mail-out/
/data/backups/
/config/config.local.php
/config/config.php

# Playwright
/test-results/
/playwright-report/

# OS / editor
.DS_Store
*.swp
*.log
